from triton.tlx.ops.kernels.mm._sm90_core import (
    _allocate_buffers,
    _consume_tile,
    _k_tile_range,
    _run_producer,
    _split_acc,
    _split_acc2,
    _store_subtile,
)
from triton.tlx.ops.kernels.mm.sm90 import _consume_tile_pieces


{{def_kernel("A", "B")}}
    M = {{size("A", 0)}}
    N = {{size("B", 1)}}
    K = {{size("A", 1)}}
    stride_bn = {{stride("B", 1)}}
    # N_TAIL > 0 splits a non-power-of-two tile into two power-of-two WGMMA
    # pieces, e.g. 192 = 128 + 64; B is K-major then.
    N0: tl.constexpr = BLOCK_N - N_TAIL

{% if SWAP_AB %}
    # Skinny M: the kernel computes C^T = B^T @ A^T, so its M is N and its N is
    # M. A_ROW_MAJOR / B_ROW_MAJOR describe B^T and A^T.
    KM = N
    KN = M
    {{tma_descriptor("desc_a", "B",
        [BLOCK_M_SPLIT, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M_SPLIT],
        [1, 0] if A_ROW_MAJOR else [0, 1]
    )}}
    {{tma_descriptor("desc_b", "A",
        [BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
        [1, 0] if B_ROW_MAJOR else [0, 1]
    )}}
{% else %}
    KM = M
    KN = N
    {{tma_descriptor("desc_a", "A",
        [BLOCK_M_SPLIT, BLOCK_K] if A_ROW_MAJOR else [BLOCK_K, BLOCK_M_SPLIT],
        [0, 1] if A_ROW_MAJOR else [1, 0]
    )}}
{% if N_TAIL %}
    # A host descriptor has one box per argument; the tail piece reads B through
    # a second, narrower box, so both B descriptors are built on the device.
    desc_b = tl.make_tensor_descriptor(
        B, shape=[N, K], strides=[stride_bn, 1],
        block_shape=[N0, BLOCK_K])
{% else %}
    {{tma_descriptor("desc_b", "B",
        [BLOCK_K, BLOCK_N] if B_ROW_MAJOR else [BLOCK_N, BLOCK_K],
        [0, 1] if B_ROW_MAJOR else [1, 0]
    )}}
{% endif %}
{% endif %}

    a, b, empty_a, full_a, empty_b, full_b = _allocate_buffers(
        desc_a, desc_b, BLOCK_M, N0, BLOCK_K, NUM_STAGES,
        NUM_MMA_GROUPS, A_ROW_MAJOR, B_ROW_MAJOR)
{% if N_TAIL %}
    desc_b_tail = tl.make_tensor_descriptor(
        B, shape=[N, K], strides=[stride_bn, 1],
        block_shape=[N_TAIL, BLOCK_K])
    b_tail = tlx.local_alloc((N_TAIL, BLOCK_K), tlx.dtype_of(desc_b), NUM_STAGES)
{% endif %}
{% if TMA_EPILOGUE_STORE %}
{% if SWAP_AB %}
    # Each consumer stores its C tile, the transpose of its accumulator.
    c_smem = tlx.local_alloc(
        (BLOCK_N, BLOCK_M_SPLIT), {{output_ptr()}}.dtype.element_ty,
        NUM_MMA_GROUPS)
    desc_c = tl.make_tensor_descriptor(
        {{output_ptr()}}, shape=[M, N], strides=[{{stride(None, 0)}}, 1],
        block_shape=[BLOCK_N, BLOCK_M_SPLIT])
{% else %}
    c_smem = tlx.local_alloc(
        (BLOCK_M_SPLIT, slice_size), {{output_ptr()}}.dtype.element_ty,
        2 * NUM_MMA_GROUPS)
    desc_c = tl.make_tensor_descriptor(
        {{output_ptr()}}, shape=[M, N], strides=[{{stride(None, 0)}}, 1],
        block_shape=[BLOCK_M_SPLIT, slice_size])
{% endif %}
{% endif %}

{% if SPLIT_K > 1 %}
    # Split-K writes fp32 partials to split_k_ws and never stores the output, so
    # out_ptr would be pruned from the kernel signature, but the autotuning
    # harness passes it positionally. _reduce_k_kernel writes the output (see
    # registry's _tlx_emit_post_kernel_code).
    keep_out_ptr = {{output_ptr()}}  # noqa: F841
{% endif %}

    with tlx.async_tasks():
        with tlx.async_task("default"):
            _run_producer(
                KM, KN, K, desc_a, desc_b, a, b, empty_a, full_a, empty_b, full_b,
                NUM_SMS, BLOCK_M, N0, BLOCK_K, GROUP_SIZE_M, NUM_STAGES,
                NUM_MMA_GROUPS, A_ROW_MAJOR, B_ROW_MAJOR, A_EVICTION, SPLIT_K
{%- if N_TAIL %}, b_tail_desc=desc_b_tail, b_tail=b_tail, N_TAIL=N_TAIL{% endif %})

        with tlx.async_task(num_warps=4, replicate=2, registers=232):
            start_pid = tl.program_id(0)
            num_pid_m = tl.cdiv(KM, BLOCK_M)
            num_pid_n = tl.cdiv(KN, BLOCK_N)
            num_tiles = num_pid_m * num_pid_n
            num_pid_in_group = GROUP_SIZE_M * num_pid_n
            consumer_id: tl.constexpr = tlx.async_task_replica_id()
            phase = 0
            buf = 0
            # Work unit = (output tile, K split), splits outermost, as in the producer.
            for tile_id in range(start_pid, num_tiles * SPLIT_K, NUM_SMS):
                mn_tile_id = tile_id % num_tiles
                split_id = tile_id // num_tiles
                k_lo, k_hi = _k_tile_range(K, split_id, BLOCK_K, SPLIT_K)
                group_id = mn_tile_id // num_pid_in_group
                first_pid_m = group_id * GROUP_SIZE_M
                group_size_m = min(num_pid_m - first_pid_m, GROUP_SIZE_M)
                pid_m = first_pid_m + ((mn_tile_id % num_pid_in_group) % group_size_m)
                pid_n = (mn_tile_id % num_pid_in_group) // group_size_m
                # TMA coordinates must be int32; a dynamic M makes the tile ids int64.
                offs_am = (pid_m * BLOCK_M + BLOCK_M_SPLIT * consumer_id).to(tl.int32)
                offs_bn = (pid_n * BLOCK_N).to(tl.int32)
{% if N_TAIL %}
                acc0 = tl.zeros((BLOCK_M_SPLIT, N0), dtype=tl.float32)
                acc1 = tl.zeros((BLOCK_M_SPLIT, N_TAIL), dtype=tl.float32)
                # The unused third piece still needs a placeholder to thread through.
                acc2 = tl.zeros((BLOCK_M_SPLIT, 8), dtype=tl.float32)
                acc0, acc1, acc2, buf, phase = _consume_tile_pieces(
                    K, a, b, b_tail, None, acc0, acc1, acc2, empty_a, full_a, empty_b, full_b,
                    buf, phase, consumer_id, BLOCK_K, NUM_STAGES, A_ROW_MAJOR, N_TAIL, 0)
                # Six equal subtiles: four from the main piece, two from the tail.
                p_0, p_1, p_2, p_3 = _split_acc(acc0, BLOCK_M_SPLIT, N0)
                t_0, t_1 = _split_acc2(acc1, BLOCK_M_SPLIT, N_TAIL)
                subtiles = (p_0, p_1, p_2, p_3, t_0, t_1)
                for slice_id in tl.static_range(6):
                    result = subtiles[slice_id]
                    offs_cn = offs_bn + slice_id * slice_size
{% if TMA_EPILOGUE_STORE %}
                    {{compute_epilogue(("offs_am", "offs_cn"), "result", result_name="fused_c", indent_width=20, val_shape=("BLOCK_M_SPLIT", "slice_size"))}}
                    slot = tlx.local_view(c_smem, 2 * consumer_id + slice_id % 2)
                    _store_subtile(desc_c, slot, fused_c, offs_am, offs_cn)
{% else %}
                    {{store_output(("offs_am", "offs_cn"), "result", indent_width=20, val_shape=("BLOCK_M_SPLIT", "slice_size"), block_indexing=True)}}
{% endif %}
{% else %}
                acc, buf, phase = _consume_tile(
                    (k_hi - k_lo) * BLOCK_K, a, b, empty_a, full_a, empty_b, full_b, buf, phase,
                    consumer_id, BLOCK_K, NUM_STAGES, A_ROW_MAJOR, B_ROW_MAJOR)
{% if SPLIT_K > 1 %}
                # This split's fp32 partial, at layer split_id of the (SPLIT_K, M, N)
                # workspace; _reduce_k_kernel sums the layers in order, adds the bias
                # and runs any fused epilogue.
                rows = offs_am + tl.arange(0, BLOCK_M_SPLIT)
                ws_split = split_k_ws + split_id.to(tl.int64) * M * N
{% if SWAP_AB %}
                # Under swap-AB acc[i, j] is C[cols[j], rows[i]]; BLOCK_N <= 64.
                cols = offs_bn + tl.arange(0, BLOCK_N)
                ws_ptrs = ws_split + cols[None, :].to(tl.int64) * N + rows[:, None]
                tl.store(ws_ptrs, acc, mask=(cols[None, :] < M) & (rows[:, None] < N))
{% else %}
                # Store a quarter at a time: the store's layout conversion stages
                # its value through shared memory, and a whole fp32 tile would not
                # fit beside the stage ring.
                subtiles = _split_acc(acc, BLOCK_M_SPLIT, BLOCK_N)
                for slice_id in tl.static_range(4):
                    cols = offs_bn + slice_id * slice_size + tl.arange(0, slice_size)
                    ws_ptrs = ws_split + rows[:, None].to(tl.int64) * N + cols[None, :]
                    tl.store(ws_ptrs, subtiles[slice_id], mask=(rows[:, None] < M) & (cols[None, :] < N))
{% endif %}
{% elif SWAP_AB %}
                # acc is C^T[offs_am:+BLOCK_M_SPLIT, offs_bn:+BLOCK_N]; C rows
                # past M are masked in the epilogue and clipped by the store.
                result = tl.trans(acc)
{% if TMA_EPILOGUE_STORE %}
                {{compute_epilogue(("offs_bn", "offs_am"), "result", result_name="fused_c", indent_width=16, val_shape=("BLOCK_N", "BLOCK_M_SPLIT"))}}
                slot = tlx.local_view(c_smem, consumer_id)
                # The previous tile's store reads this slot; drain it first.
                tlx.async_descriptor_store_wait(0)
                tlx.local_store(slot, fused_c.to(tlx.dtype_of(desc_c)))
                tlx.fence("async_shared")
                tlx.async_descriptor_store(desc_c, slot, [offs_bn, offs_am])
{% else %}
                {{store_output(("offs_bn", "offs_am"), "result", indent_width=16, val_shape=("BLOCK_N", "BLOCK_M_SPLIT"), block_indexing=True)}}
{% endif %}
{% else %}
                subtiles = _split_acc(acc, BLOCK_M_SPLIT, BLOCK_N)
                for slice_id in tl.static_range(4):
                    result = subtiles[slice_id]
                    offs_cn = offs_bn + slice_id * slice_size
{% if TMA_EPILOGUE_STORE %}
                    {{compute_epilogue(("offs_am", "offs_cn"), "result", result_name="fused_c", indent_width=20, val_shape=("BLOCK_M_SPLIT", "slice_size"))}}
                    slot = tlx.local_view(c_smem, 2 * consumer_id + slice_id % 2)
                    _store_subtile(desc_c, slot, fused_c, offs_am, offs_cn)
{% else %}
                    {{store_output(("offs_am", "offs_cn"), "result", indent_width=20, val_shape=("BLOCK_M_SPLIT", "slice_size"), block_indexing=True)}}
{% endif %}
{% endif %}
{% endif %}
{% if TMA_EPILOGUE_STORE %}
            tlx.async_descriptor_store_wait(0)
{% endif %}
