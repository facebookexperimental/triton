{% if SPLIT_K > 1 %}
from triton.tlx.ops.kernels.mm.gfx942 import matmul_kernel_gfx942
{% endif %}

{{def_kernel("A", "B")}}
{% if SPLIT_K > 1 %}
    M: tl.constexpr = {{size("A", 0)}}
    N: tl.constexpr = {{size("B", 1)}}
    K: tl.constexpr = {{size("A", 1)}}
    keep_out_ptr = {{output_ptr()}}  # noqa: F841
    # Use exactly the same partial-sum kernel as tlx.ops. The wrapper adds
    # bias and casts once in the shared reducer after this kernel completes.
    matmul_kernel_gfx942(
        A, B, A, split_k_ws, M, N, K,
        {{stride("A", 0)}}, {{stride("A", 1)}},
        {{stride("B", 0)}}, {{stride("B", 1)}},
        0, 0, N, 1,
        BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K,
        GROUP_M=GROUP_M, NUM_XCDS=NUM_XCDS, XCD_CHUNK=XCD_CHUNK,
        ADD_BIAS=False, SPLIT_K=SPLIT_K,
        SPLIT_ORDER_CHUNK=SPLIT_ORDER_CHUNK,
        LAUNCH_XCD_CHUNK=LAUNCH_XCD_CHUNK,
    )
{% else %}
    M = {{size("A", 0)}}
    N = {{size("B", 1)}}
    K = {{size("A", 1)}}
    if M * N == 0:
        return

    stride_am = {{stride("A", 0)}}
    stride_ak = {{stride("A", 1)}}
    stride_bk = {{stride("B", 0)}}
    stride_bn = {{stride("B", 1)}}
    tl.assume(stride_am > 0)
    tl.assume(stride_ak > 0)
    tl.assume(stride_bk > 0)
    tl.assume(stride_bn > 0)

    pid = tl.program_id(0).to(tl.int32)
    grid_m = (M + BLOCK_M - 1) // BLOCK_M
    grid_n = (N + BLOCK_N - 1) // BLOCK_N
    grid_mn = grid_m * grid_n

    if NUM_XCDS != 1:
        aligned = (
            grid_mn // (NUM_XCDS * XCD_CHUNK)
        ) * (NUM_XCDS * XCD_CHUNK)
        if pid < aligned:
            xcd = pid % NUM_XCDS
            local_pid = pid // NUM_XCDS
            pid = (
                (local_pid // XCD_CHUNK) * NUM_XCDS * XCD_CHUNK
                + xcd * XCD_CHUNK
                + local_pid % XCD_CHUNK
            )

    width = GROUP_M * grid_n
    group_id = pid // width
    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)
    pid_m = group_id * GROUP_M + pid % group_size
    pid_n = pid % width // group_size
    tl.assume(pid_m >= 0)
    tl.assume(pid_n >= 0)

{% if SPLIT_M_128_32 or SPLIT_M_256_64 %}
    # Two row panels share each B tile while retaining increasing K order.
    # Non-power-of-two row tiles reduce padding on the MLP target.
    BASE_PANEL_M: tl.constexpr = 256 if {{SPLIT_M_256_64}} else 128
    PANEL_M: tl.constexpr = 64 if {{SPLIT_M_256_64}} else 32
    tl.static_assert(BLOCK_M == BASE_PANEL_M + PANEL_M)
    tl.static_assert(EVEN_K)
    rows0 = pid_m * BLOCK_M + tl.arange(0, BASE_PANEL_M).to(tl.int32)
    rows1 = pid_m * BLOCK_M + BASE_PANEL_M + tl.arange(0, PANEL_M).to(tl.int32)
    cols = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(tl.int32)
    offs_m0 = rows0 % M
    offs_m1 = rows1 % M
    offs_n = cols % N
    offs_k = tl.arange(0, BLOCK_K).to(tl.int32)
    acc0 = tl.zeros((BASE_PANEL_M, BLOCK_N), dtype=ACC_TYPE)
    acc1 = tl.zeros((PANEL_M, BLOCK_N), dtype=ACC_TYPE)
    for k in range(0, K, BLOCK_K):
        b = tl.load(B + (k + offs_k[:, None]) * stride_bk + offs_n[None, :] * stride_bn)
        a0 = tl.load(A + offs_m0[:, None] * stride_am + (k + offs_k[None, :]) * stride_ak)
        a1 = tl.load(A + offs_m1[:, None] * stride_am + (k + offs_k[None, :]) * stride_ak)
        acc0 = tl.dot(a0, b, acc0, allow_tf32=ALLOW_TF32, out_dtype=ACC_TYPE)
        acc1 = tl.dot(a1, b, acc1, allow_tf32=ALLOW_TF32, out_dtype=ACC_TYPE)
    idx_n = cols[None, :]
    idx_m0 = rows0[:, None]
    idx_m1 = rows1[:, None]
    mask0 = (idx_m0 < M) & (idx_n < N)
    mask1 = (idx_m1 < M) & (idx_n < N)
    {{store_output(("idx_m0", "idx_n"), "acc0", "mask0", val_shape=("BASE_PANEL_M", "BLOCK_N"))}}
    {{store_output(("idx_m1", "idx_n"), "acc1", "mask1", val_shape=("PANEL_M", "BLOCK_N"))}}
{% else %}
    input_rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(tl.int32)
    input_cols = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(tl.int32)
    offs_m = (
        input_rows
        if M % BLOCK_M == 0
        else tl.where(input_rows < M, input_rows, 0)
    )
    offs_n = (
        input_cols
        if N % BLOCK_N == 0
        else tl.where(input_cols < N, input_cols, 0)
    )
    offs_k = tl.arange(0, BLOCK_K).to(tl.int32)
    reg_m = tl.max_contiguous(tl.multiple_of(offs_m, BLOCK_M), BLOCK_M)
    reg_n = tl.max_contiguous(tl.multiple_of(offs_n, BLOCK_N), BLOCK_N)

    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=ACC_TYPE)
    full_k_tiles: tl.constexpr = K // BLOCK_K
{% if PACKED_K_LOADS %}
    # Each thread owns eight consecutive K elements, so the loads vectorize
    # even when odd K strides make the rows only 2-byte aligned.
    LANES_K: tl.constexpr = BLOCK_K // 8
    LANES_MN: tl.constexpr = 64 // LANES_K
    WARPS: tl.constexpr = tlx.num_warps()
    for k_idx in range(0, full_k_tiles):
        k = k_idx * BLOCK_K
        packed_a: tl.constexpr = tlx.layout(
            shape=((LANES_K, LANES_MN, WARPS), (8, BLOCK_M // (LANES_MN * WARPS))),
            stride=((8, BLOCK_K, LANES_MN * BLOCK_K), (1, LANES_MN * WARPS * BLOCK_K)),
        )
        packed_b: tl.constexpr = tlx.layout(
            shape=((LANES_K, LANES_MN, WARPS), (8, BLOCK_N // (LANES_MN * WARPS))),
            stride=((8 * BLOCK_N, 1, LANES_MN), (BLOCK_N, LANES_MN * WARPS)),
        )
        a_offsets = reg_m[:, None] * stride_am + (k + offs_k[None, :]) * stride_ak
        b_offsets = (k + offs_k[:, None]) * stride_bk + reg_n[None, :] * stride_bn
        a = tlx.buffer_load(A, tlx.require_layout(a_offsets, packed_a), contiguity=8)
        b = tlx.buffer_load(B, tlx.require_layout(b_offsets, packed_b), contiguity=8)
        acc += tl.dot(
            a,
            b,
            allow_tf32=ALLOW_TF32,
            out_dtype=ACC_TYPE,
        )
{% else %}
    for k_idx in range(0, full_k_tiles):
        k = k_idx * BLOCK_K
        a_ptrs = (
            A
            + reg_m[:, None] * stride_am
            + (k + offs_k[None, :]) * stride_ak
        )
        b_ptrs = (
            B
            + (k + offs_k[:, None]) * stride_bk
            + reg_n[None, :] * stride_bn
        )
        a = tl.load(a_ptrs)
        b = tl.load(b_ptrs)
        acc += tl.dot(
            a,
            b,
            allow_tf32=ALLOW_TF32,
            out_dtype=ACC_TYPE,
        )
{% endif %}

    if K % BLOCK_K != 0:
        k = full_k_tiles * BLOCK_K
        k_mask = offs_k < K - k
        a_ptrs = (
            A
            + reg_m[:, None] * stride_am
            + (k + offs_k[None, :]) * stride_ak
        )
        b_ptrs = (
            B
            + (k + offs_k[:, None]) * stride_bk
            + reg_n[None, :] * stride_bn
        )
        a = tl.load(a_ptrs, mask=k_mask[None, :], other=0.0)
        b = tl.load(b_ptrs, mask=k_mask[:, None], other=0.0)
        acc += tl.dot(
            a,
            b,
            allow_tf32=ALLOW_TF32,
            out_dtype=ACC_TYPE,
        )

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(tl.int32)
    cols = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(tl.int32)
    idx_m = rows[:, None]
    idx_n = cols[None, :]
    mask = (idx_m < M) & (idx_n < N)
    {{store_output(("idx_m", "idx_n"), "acc", "mask", val_shape=("BLOCK_M", "BLOCK_N"))}}
{% endif %}
{% endif %}
