{{def_kernel("A", "B")}}
    # MI450X (gfx1250) GEMM from tutorials/amd_tdm_gemm_pipelined.py: TDM
    # descriptor loads into an NUM_BUFFERS-deep LDS ring, WMMA via tl.dot.
    # Shared by mm and addmm; the epilogue goes through store_output so
    # Inductor fusions (bias, activations) apply. A is
    # row-major; B is row-major [K, N] or, for nn.Linear weights, column-major,
    # loaded as [N, K] tiles and transposed in LDS. Descriptor bases are not
    # pre-offset, so TDM bounds checks zero-fill M/N/K tails.
    M = {{size("A", 0)}}
    N = {{size("B", 1)}}
    K = {{size("A", 1)}}
    if M * N == 0:
        return
    stride_am = {{stride("A", 0)}}
    stride_bk = {{stride("B", 0)}}
    stride_bn = {{stride("B", 1)}}

    pid = tl.program_id(0)
    grid_m = tl.cdiv(M, BLOCK_M)
    grid_n = tl.cdiv(N, BLOCK_N)
    width = GROUP_M * grid_n
    group_id = pid // width
    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)
    pid_m = group_id * GROUP_M + pid % group_size
    pid_n = pid % width // group_size
    off_m = pid_m * BLOCK_M
    off_n = pid_n * BLOCK_N

    a_desc = tl.make_tensor_descriptor(
        A, shape=[M, K], strides=[stride_am, tl.constexpr(1)], block_shape=[BLOCK_M, BLOCK_K]
    )
    a_buf = tlx.local_alloc((BLOCK_M, BLOCK_K), tlx.dtype_of(A), NUM_BUFFERS)
    if B_ROW_MAJOR:
        b_desc = tl.make_tensor_descriptor(
            B, shape=[K, N], strides=[stride_bk, tl.constexpr(1)], block_shape=[BLOCK_K, BLOCK_N]
        )
        b_buf = tlx.local_alloc((BLOCK_K, BLOCK_N), tlx.dtype_of(B), NUM_BUFFERS)
    else:
        b_desc = tl.make_tensor_descriptor(
            B, shape=[N, K], strides=[stride_bn, tl.constexpr(1)], block_shape=[BLOCK_N, BLOCK_K]
        )
        if B_PAD == 1:
            b_buf = tlx.local_alloc(
                (BLOCK_N, BLOCK_K), tlx.dtype_of(B), NUM_BUFFERS,
                layout=tlx.padded_shared_layout_encoding.with_identity_for([(128, 8)], [BLOCK_N, BLOCK_K], [1, 0]),
            )
        elif B_PAD == 2:
            b_buf = tlx.local_alloc(
                (BLOCK_N, BLOCK_K), tlx.dtype_of(B), NUM_BUFFERS,
                layout=tlx.padded_shared_layout_encoding.with_identity_for([(BLOCK_K, 8)], [BLOCK_N, BLOCK_K], [1, 0]),
            )
        else:
            b_buf = tlx.local_alloc((BLOCK_N, BLOCK_K), tlx.dtype_of(B), NUM_BUFFERS)

    K_ITERS = tl.cdiv(K, BLOCK_K)

    # NUM_BUFFERS-deep LDS ring. The heuristic guarantees K_ITERS >= NUM_BUFFERS,
    # so the prologue fills NUM_BUFFERS - 1 slots unpredicated. Each stage issues
    # two TDM loads, hence the 2x in every wait count.
    for s in tl.static_range(NUM_BUFFERS - 1):
        tlx.async_amd_descriptor_load(a_desc, tlx.local_view(a_buf, s), [off_m, s * BLOCK_K], clamp_bounds=False)
        if B_ROW_MAJOR:
            tlx.async_amd_descriptor_load(b_desc, tlx.local_view(b_buf, s), [s * BLOCK_K, off_n], clamp_bounds=False)
        else:
            tlx.async_amd_descriptor_load(b_desc, tlx.local_view(b_buf, s), [off_n, s * BLOCK_K], clamp_bounds=False)

    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=ACC_TYPE)
    for k in tl.range(0, K_ITERS - (NUM_BUFFERS - 1)):
        nk = k + NUM_BUFFERS - 1
        ns = nk % NUM_BUFFERS
        tlx.async_amd_descriptor_load(a_desc, tlx.local_view(a_buf, ns), [off_m, nk * BLOCK_K], clamp_bounds=False)
        if B_ROW_MAJOR:
            tlx.async_amd_descriptor_load(b_desc, tlx.local_view(b_buf, ns), [nk * BLOCK_K, off_n], clamp_bounds=False)
        else:
            tlx.async_amd_descriptor_load(b_desc, tlx.local_view(b_buf, ns), [off_n, nk * BLOCK_K], clamp_bounds=False)

        tlx.async_amd_descriptor_wait(2 * (NUM_BUFFERS - 1))

        cs = k % NUM_BUFFERS
        a = tlx.local_load(tlx.local_view(a_buf, cs))
        if B_ROW_MAJOR:
            b = tlx.local_load(tlx.local_view(b_buf, cs))
        else:
            b = tlx.local_load(tlx.local_trans(tlx.local_view(b_buf, cs)))
        acc = tl.dot(a, b, acc, out_dtype=ACC_TYPE)

    for i in tl.static_range(NUM_BUFFERS - 1):
        tlx.async_amd_descriptor_wait(2 * (NUM_BUFFERS - 2 - i))
        cs = (K_ITERS - (NUM_BUFFERS - 1) + i) % NUM_BUFFERS
        a = tlx.local_load(tlx.local_view(a_buf, cs))
        if B_ROW_MAJOR:
            b = tlx.local_load(tlx.local_view(b_buf, cs))
        else:
            b = tlx.local_load(tlx.local_trans(tlx.local_view(b_buf, cs)))
        acc = tl.dot(a, b, acc, out_dtype=ACC_TYPE)

    rows = off_m + tl.arange(0, BLOCK_M)
    cols = off_n + tl.arange(0, BLOCK_N)
    idx_m = rows[:, None]
    idx_n = cols[None, :]
    mask = (idx_m < M) & (idx_n < N)
    {{store_output(("idx_m", "idx_n"), "acc", "mask", val_shape=("BLOCK_M", "BLOCK_N"))}}
