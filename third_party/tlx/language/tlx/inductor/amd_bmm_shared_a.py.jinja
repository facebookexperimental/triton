            tlx.local_load(tlx.local_view(b{{nj}}, cur)), dot1, pin=False)
{% for mi in range(7) %}
        c{{mi}}{{nj}} = tl.dot(av{{mi}}, bv{{nj}}, c{{mi}}{{nj}})
{% endfor %}
{% endfor %}
{% for mi in range(7) %}
