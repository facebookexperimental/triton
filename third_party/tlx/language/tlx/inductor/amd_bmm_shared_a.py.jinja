{% endfor %}
{% for nj in range(5) %}
    rn{{nj}} = r + {{nj * 32}}
{% endfor %}
{% for mi in range(7) %}
    tlx.local_store(tlx.local_view(a{{mi}}, 0),
                    tl.load(A + rm{{mi}}[:, None] * stride_am
