#ifndef TLX_LAYOUT_INTERFACE
#define TLX_LAYOUT_INTERFACE

include "mlir/IR/OpBase.td"

// A TLX-owned wrapper encoding that carries a concrete underlying layout while
// deferring core TritonGPU layout verification (e.g. #tlx.no_verify_layout,
// #tlx.user_layout). Implementing this interface lets any verifier or layout
// utility see through the wrapper via a single call instead of enumerating the
// concrete wrapper attributes with isa<>.
//
// This is defined in its own file (with its own -gen-attr-interface-* rule) so
// it does not collide with the ttg-mirror interfaces declared in TLXAttrDefs.td
// (those reuse the C++ classes generated by TritonGPU and must NOT be
// regenerated here).
def TLX_LayoutAttrInterface : AttrInterface<"TLXLayoutAttrInterface"> {
  let cppNamespace = "::mlir::triton::tlx";
  let description = [{
    Contract:
      * `getUnderlyingLayout()` returns the concrete layout this wrapper directly
        carries. It may itself be another TLX layout wrapper.
      * A caller that needs a fully-unwrapped, non-wrapper encoding should use
        `tlx::getEffectiveEncoding()`, which peels nested wrappers to a fixed
        point. The wrapper's own `genVerify` guarantees the carried layout is a
        valid, already-verified encoding, so unwrapping never loses verification.
  }];
  let methods = [
    InterfaceMethod<
      /*desc=*/[{Return the layout this wrapper directly carries. May itself be a
                 TLX layout wrapper; use tlx::getEffectiveEncoding() for the
                 fully-peeled concrete encoding.}],
      /*retTy=*/"::mlir::Attribute",
      /*methodName=*/"getUnderlyingLayout">,
  ];
}

#endif // TLX_LAYOUT_INTERFACE
