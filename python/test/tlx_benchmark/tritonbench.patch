+def torch_tlx_cache_options() -> dict:
+    """Disable cache reuse across forced and reference compiles on both torch builds."""
+    import torch._inductor
+
+    options = set(torch._inductor.list_options())
+    if "force_disable_caches" in options:
+        return {"force_disable_caches": True}
