diff --git a/tritonbench/utils/tlx_l2.py b/tritonbench/utils/tlx_l2.py
new file mode 100644
--- /dev/null
+++ b/tritonbench/utils/tlx_l2.py
@@ -0,0 +1,176 @@
+"""Shared policy and in-process operator runner for TLX L2 benchmarks."""
+
+from __future__ import annotations
+
+import contextlib
+import importlib
+import logging
+import os
+import statistics
+import tempfile
+import time
+
+WARMUP_ITERS = 100
+SAMPLE_COUNT = 500
+MAX_CV = 0.03
+logger = logging.getLogger(__name__)
+
+
+def apply_defaults(args):
+    args = list(args)
+    defaults = {
+        "--latency-measure-mode": "gpu_events",
+        "--tlx-space": "heuristic",
+        "--torch-tlx-mode": "force",
+        "--warmup-iters": str(WARMUP_ITERS),
+        "--sample-count": str(SAMPLE_COUNT),
+        "--metrics": "latency,tflops,speedup,accuracy,latency_stats,noisy,host_us,cold_compile_ms",
+    }
+    for flag, value in defaults.items():
+        if not any(arg == flag or arg.startswith(flag + "=") for arg in args):
+            args.extend((flag, value))
+    if "--tlx-l2" not in args:
+        args.append("--tlx-l2")
+    return args
+
+
+def latency_stats(latency):
+    return {
+        "timing_scope": latency.timing_scope,
+        "p50_ms": latency.p50,
+        "p90_ms": latency.percentile(0.90),
+        "p99_ms": latency.percentile(0.99),
+        "cv": latency.cv,
+        "raw_cv": latency.raw_cv,
+        "raw_min_ms": min(latency.raw_times),
+        "raw_max_ms": max(latency.raw_times),
+        "n_raw": len(latency.raw_times),
+        "n_kept": len(latency.times),
+    }
+
+
+def noisy(latency):
+    return max(latency.cv, latency.raw_cv) > MAX_CV
+
+
+def host_overhead_us(fn, iterations=100):
+    import torch
+
+    torch.cuda.synchronize()
+    samples = []
+    for _ in range(iterations):
+        torch.cuda.synchronize()
+        start = time.perf_counter_ns()
+        fn()
+        samples.append((time.perf_counter_ns() - start) / 1000)
+    torch.cuda.synchronize()
+    return statistics.median(samples)
+
+
+@contextlib.contextmanager
+def cold_cache(enabled):
+    import triton
+
+    if not enabled:
+        yield
+        return
+    previous = triton.knobs.cache.dir
+    previous_compile = triton.knobs.compilation.always_compile
+    previous_env = os.environ.get("TRITON_CACHE_DIR")
+    with tempfile.TemporaryDirectory(prefix="tritonbench-cold-") as cache:
+        triton.knobs.cache.dir = cache
+        triton.knobs.compilation.always_compile = True
+        os.environ["TRITON_CACHE_DIR"] = cache
+        try:
+            yield
+        finally:
+            triton.knobs.cache.dir = previous
+            triton.knobs.compilation.always_compile = previous_compile
+            if previous_env is None:
+                os.environ.pop("TRITON_CACHE_DIR", None)
+            else:
+                os.environ["TRITON_CACHE_DIR"] = previous_env
+
+
+def run_operator(
+    op_name, provider, reference, shapes, direction="fwd", *, cudagraph=False, cold=True
+):
+    """Run existing providers on explicit canonical shapes, preserving order."""
+    from tritonbench.data.loader import get_tlx_inputs
+    from tritonbench.utils.parser import get_parser
+
+    args = apply_defaults(
+        [
+            "--op",
+            op_name,
+            "--only",
+            f"{reference},{provider}",
+            "--baseline",
+            reference,
+            "--mode",
+            direction,
+            "--force",
+            "--keep-going",
+            "--metrics",
+            "latency,tflops,accuracy,host_us,cold_compile_ms,latency_stats",
+        ]
+    )
+    if cudagraph:
+        args.append("--cudagraph")
+    tb_args, extra = get_parser(args).parse_known_args(args)
+    tb_args.cold_compile = cold
+    cls = importlib.import_module(f"tritonbench.operators.{op_name}").Operator
+
+    class ExplicitShapes(cls):
+        __module__ = cls.__module__
+
+        def get_input_iter(self):
+            return get_tlx_inputs(self, shapes)()
+
+    operator = ExplicitShapes(tb_args, extra)
+    operator.run()
+    return operator.output.result
+
+
+def check_accuracy(op, fn, baseline_fn):
+    import torch
+    from torch.utils._pytree import tree_flatten
+
+    try:
+        actual = fn()
+        if op.mode.value == "bwd":
+            actual = op._clone_gradients(actual, mode="BWD")
+        reference = baseline_fn()
+        if op.name == "tlx_flash_attention_varlen":
+            reference = op._varlen_unpad(reference)
+        if op.mode.value == "bwd":
+            reference = op._clone_gradients(reference, mode="BWD")
+        got, got_spec = tree_flatten(actual)
+        ref, ref_spec = tree_flatten(reference)
+        assert got_spec == ref_spec
+        assert any(isinstance(t, torch.Tensor) for t in got)
+        for output, expected in zip(got, ref):
+            if output is None or expected is None:
+                assert output is None and expected is None
+                continue
+            assert torch.isfinite(output).all() and torch.isfinite(expected).all()
+            rel = (
+                0.05
+                if op.name == "addmm"
+                else (0.008 if expected.dtype == torch.bfloat16 else 0.001)
+            )
+            if op.tb_args.bitwise:
+                assert torch.equal(output, expected)
+            else:
+                requested_rtol, requested_atol = op._tlx_requested_tolerances
+                rtol = rel if requested_rtol is None else requested_rtol
+                atol = (
+                    rel * expected.abs().max().item()
+                    if requested_atol is None
+                    else requested_atol
+                )
+                torch.testing.assert_close(output, expected, rtol=rtol, atol=atol)
+        return True
+    except AssertionError as error:
+        logger.warning("TLX L1 accuracy check failed: %s", error)
+        return False
