      %10 = ttg.convert_layout %9 {ttg.partition = array<i32: 0>} : tensor<128xf16, #ttg.slice<{dim = 1, parent = #linear}>> -> tensor<128xf16, #blocked>
      tt.store %8, %10 {ttg.partition = array<i32: 0>} : tensor<128x!tt.ptr<f16>, #blocked>
