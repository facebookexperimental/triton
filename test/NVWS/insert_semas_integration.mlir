      scf.yield
    } {tt.scheduled_max_stage = 0 : i32, ttg.partition = array<i32: 0>}
    scf.yield
  } {tt.warp_specialize, ttg.partition = array<i32: 0, 2>, ttg.partition.stages = [0, 1], ttg.warp_specialize.tag = 0 : i32}
