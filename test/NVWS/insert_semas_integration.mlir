  // TMA-NEXT: ttng.wait_barrier [[STORE_ENTRY]],
  tt.func @converted_descriptor_store_completion(%desc: !tt.tensordesc<128x64xf16, #shared>, %i: i32, %lb: i32, %ub: i32, %step: i32) {
