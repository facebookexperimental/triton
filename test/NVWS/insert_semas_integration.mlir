// SMEM-LABEL: tt.func @semaphore_result_outside_scheduled_loop
// SMEM: [[OUTSIDE_BUF:%.*]] = ttg.local_alloc : () -> !ttg.memdesc<1xi32, #shared, #smem, mutable>
// SMEM: ttg.local_store {{.*}}, {{.*}} {ttg.partition = array<i32: 2>}
