// RUN: triton-opt %s --nvgpu-warp-specialization="capability=100 num-stages=2 smem-budget=232448" | FileCheck %s

// Full BM128 2-CTA FA backward TTGIR captured immediately before
// NVGPUWarpSpecialization. The inner M loop is guaranteed non-empty, so its
// first dK/dV MMAs initialize operand D and the dominating zero stores must not
// create separate cross-partition channels.
// CHECK-LABEL: tt.func public @_attn_bwd
// CHECK-NOT: ttng.tmem_store %cst
