// RUN: triton-opt %s -tritongpu-promote-lhs-to-tmem --mlir-use-nameloc-as-prefix | FileCheck %s --check-prefix=DEFAULT
// RUN: env TRITON_WS_MEMORY_SPACE_TOPK=2 TRITON_WS_MEMORY_SPACE_PICK=1 triton-opt %s -tritongpu-promote-lhs-to-tmem --mlir-use-nameloc-as-prefix | FileCheck %s --check-prefix=SEARCH

// Captured from the production BM128 FA-backward kernel immediately before
// PromoteLHSToTMem. The source memtype annotations have been removed.
// Rank 0 preserves the heuristic: dS stays in SMEM because dQ consumes its
// transposed sibling. Rank 1 explores the legal alternative used by the
// annotated target: dK consumes a new TMEM copy while dQ remains in SMEM.
//
// DEFAULT: %[[DS:dsT[^ ]*]] = arith.truncf
// DEFAULT-NEXT: %[[DS_SMEM:[^ ]+]] = ttg.local_alloc %[[DS]]
// DEFAULT-NEXT: %{{[^ ]+}} = ttng.tc_gen5_mma %[[DS_SMEM]],
// DEFAULT-NEXT: %[[DS_TRANS:[^ ]+]] = ttg.memdesc_trans %[[DS_SMEM]]
// DEFAULT-NEXT: %{{[^ ]+}} = ttng.tc_gen5_mma %[[DS_TRANS]],
// DEFAULT-NOT: allocation.memorySpaceSearch
//
// SEARCH: %[[DS:dsT[^ ]*]] = arith.truncf
// SEARCH-NEXT: %[[DS_SMEM:[^ ]+]] = ttg.local_alloc %[[DS]]
// SEARCH-NEXT: %[[DS_TMEM:[^ ]+]] = ttng.tmem_alloc %[[DS]] {allocation.memorySpaceSearch}
// SEARCH-NEXT: %{{[^ ]+}} = ttng.tc_gen5_mma %[[DS_TMEM]],
// SEARCH-NEXT: %[[DS_TRANS:[^ ]+]] = ttg.memdesc_trans %[[DS_SMEM]]
// SEARCH-NEXT: %{{[^ ]+}} = ttng.tc_gen5_mma %[[DS_TRANS]],

